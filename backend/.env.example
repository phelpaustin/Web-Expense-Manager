# Copy this file to .env and fill in real values. Never commit .env.

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Database connection string.
# Local dev (default): a SQLite file, no setup needed.
DATABASE_URL=sqlite:///./expense.db
# Supabase / Postgres (production): copy from Supabase > Project Settings > Database.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Auth — generate a strong random value for production, e.g. `openssl rand -hex 32`.
# With a non-SQLite DATABASE_URL the app refuses to start if this is a placeholder,
# the dev default, or shorter than 32 characters.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Optional: enable Google Sign-In by setting your Google OAuth client ID
# (must match VITE_GOOGLE_CLIENT_ID on the frontend).
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Demo account. Local dev enables it automatically (demo1234).
# In production it is created ONLY if you set a private password here.
# DEMO_PASSWORD=set-a-private-password-to-enable-demo

# Public frontend URL, used to build email-verification and password-reset links.
FRONTEND_URL=http://localhost:5173

# Email — required for production password sign-up verification; preferred: Resend HTTP API.
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=onboarding@resend.dev   # or no-reply@yourdomain.com once a domain is verified

# SMTP fallback (used only if RESEND_API_KEY is not set). Note: many hosts
# (e.g. Render) block outbound SMTP ports, so prefer the Resend API above.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=no-reply@yourdomain.com

# Shared secret for POST /api/alerts/send-digest (a daily budget-alert email
# job, meant to be triggered by an external scheduler — see
# .github/workflows/alert-digest.yml). Generate with `openssl rand -hex 32`.
# Leave unset to disable the endpoint entirely.
# CRON_SECRET=set-a-private-random-value

# Number of reverse proxies in front of the backend (Render, a CDN, ...). Rate limits
# are per visitor IP; behind a proxy they would otherwise be shared by everyone.
# 0 (default) = none. Too high lets clients spoof their IP; too low shares one limit.
# To find the value on a new host: leave it 0, deploy, and read the warning
# "Requests carry X-Forwarded-For (N entries)" in the logs; N is the number to set.
# TRUSTED_PROXY_COUNT=1

# Rate limits per visitor IP (slowapi format; ";" combines limits). Defaults shown.
# RATE_LIMIT_LOGIN=5/minute;60/hour
# RATE_LIMIT_REGISTER=5/hour;20/day
# RATE_LIMIT_GOOGLE=10/minute;60/hour
# RATE_LIMIT_SENSITIVE=10/hour   # change-password and delete-account while signed in
