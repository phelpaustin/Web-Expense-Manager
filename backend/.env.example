# Copy this file to .env and fill in real values. Never commit .env.

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Database connection string.
# Local dev (default): a SQLite file, no setup needed.
DATABASE_URL=sqlite:///./expense.db
# Supabase / Postgres (production): copy from Supabase > Project Settings > Database.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Auth — generate a strong random value for production, e.g. `openssl rand -hex 32`.
SECRET_KEY=dev-secret-change-me

# Optional: enable Google Sign-In by setting your Google OAuth client ID
# (must match VITE_GOOGLE_CLIENT_ID on the frontend).
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Demo account. Local dev enables it automatically (demo1234).
# In production it is created ONLY if you set a private password here.
# DEMO_PASSWORD=set-a-private-password-to-enable-demo

# Public frontend URL, used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# Email — preferred: Resend HTTP API (works where SMTP ports are blocked).
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=onboarding@resend.dev   # or no-reply@yourdomain.com once a domain is verified

# SMTP fallback (used only if RESEND_API_KEY is not set). Note: many hosts
# (e.g. Render) block outbound SMTP ports, so prefer the Resend API above.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=no-reply@yourdomain.com
