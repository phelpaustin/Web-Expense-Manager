{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./frontend/package-lock.json)",
      "Read(./frontend/src/styles/index.css)",
      "Read(**/dist/**)",
      "Read(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.env)"
    ],
    "ask": [
      "Read(./backend/alembic/versions/**)",
      "Read(./backend/tests/**)",
      "Read(./frontend/src/__tests__/**)"
    ]
  }
}
