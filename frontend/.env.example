# Frontend build-time config.
# Local dev leaves this unset — Vite proxies /api to the backend on port 8000.
# In production (Vercel), set VITE_API_URL to your deployed backend URL:
# VITE_API_URL=https://expense-backend.onrender.com

# Optional: enable Google Sign-In by setting your Google OAuth client ID.
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
