# Copy to .env (in this folder) and fill in. Never commit .env.

# Database password (used by the db, backend and backup containers). Pick a long random value.
POSTGRES_PASSWORD=change-me

# Signing key, at least 32 characters: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Where you open the site. Use the exact address from the browser, with no trailing slash:
# a LAN address, a Tailscale name, or your own domain.
FRONTEND_URL=http://192.168.1.50:8080
CORS_ORIGINS=http://192.168.1.50:8080

# Port the site listens on, and who may reach it. With a Cloudflare Tunnel (or Tailscale) running on this
# machine, set WEB_BIND=127.0.0.1 so nothing else on the local network can bypass it.
WEB_PORT=8080
# WEB_BIND=127.0.0.1

# One reverse proxy (the web container) sits in front of the backend. Add 1 more if you also use a tunnel
# or proxy that adds X-Forwarded-For (see backend/.env.example).
TRUSTED_PROXY_COUNT=1

# Email for sign-up verification and password reset (see backend/.env.example for all options).
# SMTP is easiest from a home network; Resend works too.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# RESEND_API_KEY=
# EMAIL_FROM=

# Optional: daily budget alert emails (the digest container calls the backend with this secret).
# CRON_SECRET=openssl rand -hex 32

# Optional: Google sign-in (the same client ID is used by the backend and built into the frontend).
# GOOGLE_CLIENT_ID=

# Optional: AI help in Import.
# ANTHROPIC_API_KEY=

# Nightly backups: folder on this machine and how many days to keep.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
